# Copy to .env.local for local work; set the same names in Vercel > Project > Settings > Environment Variables.

# --- Call-request form (optional) ---
# Leave blank and requests are passed to the mailer the old site used.
# For Gmail: SMTP_USER is the Gmail address, SMTP_PASS is a Google "app password".
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# CONTACT_TO=            # where requests are delivered (defaults to SMTP_USER)

# --- "Ring the bell" AI helper (optional) ---
# The section stays hidden until a key is set. This is an OpenAI API key from
# platform.openai.com, billed per use. A ChatGPT subscription does not include one.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# --- Google Analytics (optional) ---
# Measurement ID, looks like G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
